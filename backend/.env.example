# Copy to .env and fill in. No secret has a default: a missing value is a
# startup crash, never a silent fallback to a well-known development value.

NODE_ENV=development
PORT=3000

# Postgres. In production the URL MUST request TLS (sslmode=require) —
# startup refuses otherwise. Behind a serverless platform, point this at a
# pooler (PgBouncer / Supabase pooler / RDS Proxy), not the raw instance.
DATABASE_URL=postgres://portage:portage_dev@127.0.0.1:5432/portage_dev

# Generate each of these separately:  openssl rand -base64 48
# Minimum 32 characters. Never reuse one value across two variables.
SESSION_SECRET=
STORAGE_SIGNING_SECRET=
PSEUDONYM_PEPPER=

# Comma-separated exact origins. https only in production. No wildcards:
# this API is cookie-authenticated, so a wildcard origin is not permissible.
ALLOWED_ORIGINS=http://localhost:3000

# Set true when running behind a TLS-terminating proxy in a non-production
# environment (e.g. a staging tunnel) so cookies still carry Secure.
FORCE_SECURE_COOKIES=false
TRUST_PROXY=false
