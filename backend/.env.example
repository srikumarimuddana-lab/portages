# Copy to .env and fill in. No secret has a default: a missing value is a
# startup crash, never a silent fallback to a well-known development value.

NODE_ENV=development
PORT=3000

# Postgres. In production the URL MUST request TLS (sslmode=require) —
# startup refuses otherwise. Behind a serverless platform, point this at a
# pooler (PgBouncer / Supabase pooler / RDS Proxy), not the raw instance.
DATABASE_URL=postgres://portage:portage_dev@127.0.0.1:5432/portage_dev

# Generate each of these separately:  openssl rand -base64 48
# Minimum 32 characters. Never reuse one value across two variables.
SESSION_SECRET=
STORAGE_SIGNING_SECRET=
PSEUDONYM_PEPPER=

# Comma-separated exact origins. https only in production. No wildcards:
# this API is cookie-authenticated, so a wildcard origin is not permissible.
ALLOWED_ORIGINS=http://localhost:3000

# Set true when running behind a TLS-terminating proxy in a non-production
# environment (e.g. a staging tunnel) so cookies still carry Secure.
FORCE_SECURE_COOKIES=false
TRUST_PROXY=false

# Apple MapKit JS. Optional — omit all three and the map endpoint returns 503.
# From the Apple Developer portal: Certificates, Identifiers & Profiles > Keys
# > create a key with MapKit JS enabled, then download the .p8 once.
# MAPKIT_PRIVATE_KEY is the full PKCS#8 PEM contents of that .p8 file; if your
# host cannot hold newlines, escape them as \n and they are restored at load.
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
MAPKIT_PRIVATE_KEY=

# ── OAuth ───────────────────────────────────────────────────────────────────
# Each provider is optional, but ID and SECRET must be set together.
# Setup instructions: docs/setup/google-oauth.md and docs/setup/facebook-oauth.md
#
# The redirect URI you register with each provider must match EXACTLY:
#   {PUBLIC_ORIGIN}/api/auth/oauth/google/callback
#   {PUBLIC_ORIGIN}/api/auth/oauth/facebook/callback
PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── AWS (email + SMS) ───────────────────────────────────────────────────────
# Setup instructions: docs/setup/aws-messaging.md
# Credentials are all-or-nothing. Each channel additionally needs its own
# sender identity below, or it stays visibly disabled rather than failing
# at send time.
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email: a verified SES identity, and the configuration set carrying the
# bounce/complaint event destination (see the setup guide — do not skip it).
SES_FROM_ADDRESS=
SES_CONFIGURATION_SET=

# SMS: phone number ID, pool ID or sender ID from AWS End User Messaging.
SMS_ORIGINATION_IDENTITY=
