{
  "name": "portage-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --experimental-strip-types --import ./test/register-hook.mjs --test test/**/*.test.ts",
    "typecheck:offline": "tsc -p tsconfig.check.json",
    "seed:regina": "node --experimental-strip-types --import ./test/register-hook.mjs src/scripts/seed-regina.ts",
    "typecheck:shim": "tsc -p tsconfig.shim.json"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
